<?xml version="1.0" encoding="utf-8"?>
<!--
  The app stores renters' phone numbers and financial records in its
  local database. Exclude every app-data domain from cloud backup and
  from device-to-device transfer (Android 12+). Together with
  android:allowBackup="false" in the manifest, no app data leaves the
  device through Android backup mechanisms.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
